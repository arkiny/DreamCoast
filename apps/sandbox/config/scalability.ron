// Scalability config — the data-driven tier tables (Phase 11 Stage D, data-driven layer).
//
// This file is the SINGLE SOURCE of the per-tier `QualityPreset` values and the per-tier
// scalability-group levels that `apps/sandbox/src/quality.rs` used to hard-code. It is
// embedded into the binary at compile time via `include_str!`, so the engine always works
// even if this file is absent; an on-disk copy (this path, `assets/config/scalability.ron`,
// or `SCALABILITY_CONFIG=<path>`) overrides the embedded copy at startup, and a parse error
// logs a warning and falls back to the embedded default.
//
// NOTE — the gallery byte-identical anchor (`gallery_preset()`) is deliberately NOT here: it
// stays compiled into Rust so a stray edit to this file can never silently move the anchor.
//
// Each tier lists its full `QualityPreset` field set (must reproduce the historical hard-coded
// values EXACTLY — `Med` is the byte-identical no-regression baseline) plus its six group
// levels (0..=3, descriptive-not-authoritative: a coarse VIEW of the preset for UI/logs).
// Fields no gallery/tier pass reads still carry their legacy value so each entry is a complete,
// self-describing snapshot. Group order matches `ScalabilityGroup::ALL`.
(
    tiers: [
        // Low-end fallback: reflection hit cache off, cheap stochastic half-res SSR, half the
        // GI samples, lower reflection roughness cutoff (GDF takes over sooner). Hard shadows.
        (
            tier: Low,
            preset: (
                gi_spp: 2,
                gi_denoise: true,
                reflect_cache: false,
                surface_cache: false,
                ssr_stochastic: true,
                reflect_max_roughness: 0.3,
                gdf_ao: false,
                ssao: true,
                firefly_clamp: true,
                shadow_softness: 0.0,
                shadow_taps: 8,
                cache_relight_period: 48,
                gi_half_res: true,
                cache_relight_spp: 2,
                gi_max_steps: 24,
                reflect_max_steps: 64,
                reflect_half_res: true,
                render_scale: 0.6667,
                gdf_cone_k: 0.05,
                gi_res_div: 3,
                reflect_res_div: 2,
                ao_res_div: 1,
                gi_atrous_steps: 2,
                reflect_history_clamp: 1,
                reflect_clamp_gamma: 1.25,
                ssr_history_clamp: 0,
                ssr_clamp_gamma: 1.25,
                gi_temporal_clamp: 0.0,
                gi_volume_period: 4,
                // Deferred-parity cache skylight — see the Med preset for the derivation and the
                // measured numbers. Kept in lockstep across tiers: it is a CORRECTNESS fix (one
                // skylight definition shared with the deferred pass), not a quality dial.
                cache_sky_occlude: true,
            ),
            groups: (
                resolution: 0,
                global_illumination: 1,
                reflection: 0,
                ambient_occlusion: 1,
                shadow: 0,
                surface_cache: 0,
            ),
        ),
        // Content default. Mostly the pre-tier legacy values; three cost knobs were retuned for the
        // Sponza 1080p-60fps track (docs/sponza-perf.md, user-approved 2026-07-06): `ssao` off (the
        // redundant 2nd AO — gdf_ao already gives contact AO), `ao_res_div` 2 (half-res AO, a low-
        // frequency term), `gi_volume_period` 4 (amortize the view-independent DDGI update). The
        // gallery PT anchor resolves against `gallery_preset()`, NOT this, so it is unaffected.
        //
        // 2026-07-25 lighting-closure promotion (docs/lighting-ao-shadow-closure.md, measured on
        // RTX 2070 SUPER / sponza_intel 1080p — the first GPU profile of that scene):
        //   render_scale 0.6667 — internal 720p + TAAU upscale, aligning with the Apple tier and
        //     the reference engine's default internal-res + temporal upscale. Also the anti-flicker
        //     carrier: native Med had NO AA at all, which was the measured root of the doorway
        //     shimmer (primary-visibility aliasing of sub-pixel bright apertures).
        //   reflect_res_div 4 — quarter-res reflection trace + the existing bilateral upsample
        //     (Metal-measured "rough content free"; DX≡VK verified in the closure batch).
        //   cache_grid on — kills the O(num_cards) per-hit surface-cache scan (gdf.rs documents
        //     30+ ms at 2694 cards); documented result-identical superset + tolerance cap.
        //   taau_antiflicker on — the F6O luma anti-flicker: door-ROI dolly flicker 5.88 -> 1.96
        //     avg/ch, bright-pixel std 124.6 -> 53.9 (the shimmer gate F6O asked for now exists:
        //     tools/seq-stability.py + the closure doc's ratchet numbers).
        //   gi_volume_period 2 + gi_volume_spp 4 + gi_dir_sets 4 — the same rays-per-frame
        //     budget laid out over 4x the threads: the spp16 single-thread-per-probe update was
        //     LATENCY-bound (gi_volume 22.5 -> 11.1 ms DX / 8.5 ms VK), and the F6K direction-set
        //     rotation keeps full angular coverage integrated across 4 cycles.
        //   reflect_max_steps 56 + gdf_cone_k 0.06 + reflect_res_div 6 — the Apple-tier march
        //     economy, DX==VK-measured in the closure batch (P_REFLECT_RES_DIV=4 restores the
        //     sharper trace if a mirror-heavy scene needs it).
        (
            tier: Med,
            preset: (
                gi_spp: 1,
                gi_denoise: true,
                reflect_cache: true,
                surface_cache: false,
                ssr_stochastic: false,
                reflect_max_roughness: 0.5,
                gdf_ao: true,
                ssao: false,
                firefly_clamp: true,
                shadow_softness: 0.0,
                shadow_taps: 16,
                cache_relight_period: 40,
                gi_half_res: true,
                cache_relight_spp: 1,
                gi_max_steps: 24,
                reflect_max_steps: 56,
                reflect_half_res: true,
                render_scale: 0.6667,
                gdf_cone_k: 0.06,
                gi_res_div: 3,
                reflect_res_div: 6,
                ao_res_div: 2,
                gi_atrous_steps: 2,
                reflect_history_clamp: 1,
                reflect_clamp_gamma: 1.25,
                ssr_history_clamp: 0,
                ssr_clamp_gamma: 1.25,
                gi_temporal_clamp: 0.0,
                gi_volume_period: 2,
                cache_grid: true,
                taau_antiflicker: true,
                gi_volume_spp: 4,
                gi_dir_sets: 4,
                // TAAU motion sharpness (docs/taau-motion-sharpness.md): this tier upscales, so it
                // owns the "TAA is blurry when you move" artifact. Root cause = the history is
                // resampled once per moving frame and a bilinear kernel is a low-pass, so inside the
                // accumulation loop the softening compounds. Catmull-Rom fixes the kernel; the two
                // companions follow from it — the post-sharpen is retired (it re-synthesized edges
                // and amplified noise; the resample now recovers the real detail) and the clamp box
                // widens a notch (a sharper history lands outside a tight box more often).
                // Measured, 1080p door dolly, DX and VK: motion gradient energy +43%, lag residual
                // vs a converged still -6%, with the G3 shimmer ratchet HELD (ROI flicker 2.18/2.13
                // <= 2.2, bright std 47/44 <= 60). The velocity-gated history cap is deliberately
                // NOT enabled — measured negative on an upsampler (see quality.rs).
                taau_catmull_rom: true,
                taau_clamp_expand: 2.5,
                taau_sharpen: 0.0,
                // Deferred-parity cache skylight — one skylight definition for both pipelines.
                // The legacy path it replaces (per-ray sky-on-miss + the `skylight_floor` = 1.0
                // IBL top-up) sums to `E·esc + E·(1-esc) = E`: the escape fraction cancels, so a
                // cached texel took the FULL open-sky irradiance regardless of enclosure, while
                // the deferred gives the same surface `E·V·dot_factor·ao·kd`. Since reflections
                // read the cache and direct pixels read the deferred, every reflected surface
                // carried a stronger, bluer skylight than its direct view. Measured on the
                // Intel-Sponza chromeball crop (DX, 192-frame warmup): B-R bias +40.0 -> +0.4
                // against the path tracer's +7.0, crop residual vs PT 73.0 -> 63.0, with the
                // reflected floor's energy preserved (luma 122.0 -> 117.9, PT 100.1).
                // NOTE: this forces the SYNC relight (see `async_cache_on` in main.rs) — the
                // async-compute path cannot read the sky-visibility SH volumes.
                cache_sky_occlude: true,
            ),
            groups: (
                resolution: 1,
                global_illumination: 1,
                reflection: 1,
                ambient_occlusion: 2,
                shadow: 1,
                surface_cache: 1,
            ),
        ),
        // Quality: opt-in multibounce surface cache + GDF AO, 2x GI samples, higher reflection
        // roughness cutoff, aesthetic soft shadows (diverges slightly from PT — see docs).
        //
        // 60fps wave (docs/phase-high-60fps-plan.md). Before it, High measured **6.5 fps** at 1080p
        // in sponza_intel (153.8 ms door / 197.7 ms vault) — not the price of High's quality, but the
        // fact that High had never received an optimization wave: it was still carrying the GALLERY
        // ANCHOR's settings, whose purpose is byte-identity, not interactivity. Three of them were
        // load-bearing and none of them buys image quality at this scene scale:
        //   * `reflect_half_res: false` / `gi_half_res: false` made the tier's OWN `reflect_res_div`
        //     / `gi_res_div` dead code (they are only consumed when the half-res flag is on —
        //     main.rs:3714 / :3378), so both traces ran at full internal resolution.
        //   * `cache_relight_period: 1` is the anchor's "every card every frame" path
        //     (sdf_cache_light.slang:166). It cost 277 ms (door) / 431 ms (vault) whenever the
        //     surface cache was not converged — invisible in a static profile only because the
        //     convergence freeze arms after `cache_freeze_passes` AMORTIZATION passes
        //     (main.rs:6835), i.e. after 3 frames at period 1.
        // The frame is 100% GPU-bound (fence-wait 153.587 of frame 155.675), so every change here is
        // GPU work removed; CPU-side levers were measured to be worth nothing.
        // MEASURED after (release, tools/perf-profile.py, 62-frame steady state, 1920x1080):
        //   door  13.044 ms DX / 13.072 ms VK      vault  14.805 ms DX / 15.184 ms VK
        // = 12-13x, 60 fps met at both cameras on both backends with 1.5 ms of margin.
        (
            tier: High,
            preset: (
                gi_spp: 16,
                gi_denoise: true,
                reflect_cache: true,
                surface_cache: true,
                ssr_stochastic: false,
                reflect_max_roughness: 0.6,
                gdf_ao: true,
                // The screen-space near-field AO multiplies into the SAME diffuse ambient the GDF
                // far-field AO already occludes (pbr.slang:708). At this scene's scale the two
                // overlap; dropping it is the cheapest 2.19 ms in the frame. Med/Low/Apple already
                // ship it off — High was the only tier paying for both.
                ssao: false,
                firefly_clamp: true,
                shadow_softness: 0.03,
                shadow_taps: 16,
                // Fixed-budget surface-cache relight: 1/8 of the cards per frame (round-robin,
                // sdf_cache_light.slang:195), NOT a freeze. `cache_freeze_passes` counts full
                // amortization PASSES, so the total relight work before convergence is IDENTICAL to
                // period 1 — only its distribution changes, from 3 catastrophic frames to 24 cheap
                // ones. Converged quality is therefore bit-unchanged; what improves is frame pacing.
                // `cache_relight_spp` stays at the High value of 8: in steady state the relight is
                // skipped entirely so the ray count is free, and during the transient it buys a
                // cleaner cache. Worst case (a lighting-epoch change re-arms the relight) measured
                // 50.4 ms at the vault for the ~24 frames of re-convergence — the one number this
                // wave does NOT fix; see the plan doc's transient section.
                cache_relight_period: 8,
                gi_half_res: true,
                cache_relight_spp: 8,
                gi_max_steps: 64,
                reflect_max_steps: 96,
                reflect_half_res: true,
                // Internal render scale + TAAU (UE's ScreenPercentage lever). 0.90 is the mildest
                // setting that clears the target; it also gives High the temporal AA it did not have
                // at render_scale 1.0 (no TAAU pass ran at all), so edge quality is a net gain.
                render_scale: 0.90,
                gdf_cone_k: 0.06,
                gi_res_div: 3,
                reflect_res_div: 4,
                ao_res_div: 2,
                gi_atrous_steps: 2,
                reflect_history_clamp: 2,
                reflect_clamp_gamma: 1.25,
                ssr_history_clamp: 0,
                ssr_clamp_gamma: 1.25,
                gi_temporal_clamp: 0.0,
                gi_volume_period: 2,
                cache_grid: true,
                gi_volume_spp: 1,
                gi_dir_sets: 16,
                // High now upscales, so it owns the "TAA is blurry when you move" artifact and needs
                // the landed motion-sharpness stack (docs/taau-motion-sharpness.md) — without these
                // the serde defaults would give it the pre-Catmull-Rom bilinear history. Same values
                // as Med; `gi_dir_sets: 16` (vs Med's 4) keeps High's finer volume-direction rotation.
                taau_antiflicker: true,
                taau_catmull_rom: true,
                taau_clamp_expand: 2.5,
                taau_sharpen: 0.0,
                // Deferred-parity cache skylight — see the Med preset for the derivation and the
                // measured numbers. Kept in lockstep across tiers: it is a CORRECTNESS fix (one
                // skylight definition shared with the deferred pass), not a quality dial.
                cache_sky_occlude: true,
            ),
            groups: (
                resolution: 2,
                global_illumination: 3,
                reflection: 3,
                ambient_occlusion: 2,
                shadow: 3,
                surface_cache: 3,
            ),
        ),
        // Apple-platform default (macOS perf, axis A). Med-derived; cost knobs pushed for the
        // weak unified iGPU + TBDR of Apple Silicon. Auto-selected only on an Apple GPU with
        // `RENDER_QUALITY` unset; every value here is a tier default its own env var overrides.
        (
            tier: Apple,
            preset: (
                gi_spp: 1,
                gi_denoise: true,
                reflect_cache: true,
                surface_cache: false,
                ssr_stochastic: true,
                reflect_max_roughness: 0.4,
                gdf_ao: true,
                ssao: false,
                firefly_clamp: true,
                shadow_softness: 0.0,
                shadow_taps: 16,
                cache_relight_period: 64,
                gi_half_res: true,
                cache_relight_spp: 1,
                gi_max_steps: 24,
                reflect_max_steps: 56,
                reflect_half_res: true,
                render_scale: 0.67,
                gdf_cone_k: 0.06,
                gi_res_div: 4,
                reflect_res_div: 6,
                // M3-C: quarter-res AO trace (the bilateral upsample lifts it back) — after the
                // trace-res denoise reorders, gdf_ao was the remaining top pass (~3.9ms half-res).
                ao_res_div: 4,
                gi_atrous_steps: 1,
                reflect_history_clamp: 1,
                reflect_clamp_gamma: 1.25,
                ssr_history_clamp: 0,
                ssr_clamp_gamma: 1.25,
                gi_temporal_clamp: 0.0,
                gi_volume_period: 4,
                // VSM SMRT (V4's deferred tier knob): the lighting pass's biggest term.
                // 4 rays x 6 samples measured 6.2 -> 3.6 ms on the dungeon floor with
                // the same contact hardening (pre-ray + own-texel probe carry contact);
                // higher tiers keep the reference 7x8.
                vsm_smrt_rays: 4,
                vsm_smrt_samples: 6,
                // Reflection-quality v2 stack (Metal-verified on Apple hardware — this tier only
                // exists on the Metal backend, so the pending DX≡VK pass can't be hit from here;
                // Low/Med/High keep the serde-default OFF until the Windows parity run).
                // Measured on M3/glossyball: prefilter removes the rough floor from the K loop,
                // the screen-hit early-out serves on-screen hits from full-res lit history, and
                // the card grid cuts the per-hit card scan — SPP4 full stack ≈ the K=1 legacy
                // frame cost, with real glossy structure instead of the milky single-ray wash.
                reflect_stochastic: true,
                reflect_prefilter: 0.4,
                reflect_glossy_spp: 4,
                reflect_screen_hit: true,
                cache_grid: true,
                card_mesh_capture: true,
                // cache_adaptive_res stays off: +~3ms relight (layout loads in the gather) —
                // High-tier material once DX≡VK passes.
                // 60fps-margin: fp16-packed TAAU history (8B/px, no pos buffer) — the history
                // ping-pong dominates the taau pass at the Retina output this tier upscales to.
                taau_packed_history: true,
                // Baked ACES tonemap LUT: the full RRT+ODT filmic response at one strip fetch
                // per pixel (the legacy path evaluated a cheap analytic fit per pixel instead).
                tonemap_aces: true,
                // B2 mirror compaction: near-mirror pixels re-traced dense at half res via the
                // compacted indirect dispatch — the 1/6-res trace's upsample cannot resolve a
                // mirror image (chrome showed the trace texels as blocks). Cost scales with the
                // on-screen mirror area.
                reflect_compact_div: 2,
                // HWRT refine: the compacted mirror rays trace the scene TLAS; shading is the
                // hybrid — cache-cone lighting (converged multibounce, radiance/albedo split)
                // re-modulated by the true material albedo at the exact hit. The whole mirror
                // resolves coherent real-scene colours, and the refine is FASTER than the SW
                // march it replaces (1.0 ms vs 1.4 ms, chromeball div2).
                reflect_compact_hwrt: true,
                // Deferred-parity cache skylight: the relight reads the SAME SH sky-visibility
                // occlusion the deferred lighting applies, instead of the legacy sky-on-miss +
                // unoccluded IBL floor whose escape estimate over-injects blue on interior cards
                // (the cache-vs-deferred tone split a mirror exposes).
                cache_sky_occlude: true,
                // Compact screen fetch, re-enabled by the parity skylight above (the tone seam
                // that forced the single-source rebaseline is gone): near-footprint on-screen
                // mirror hits read the full-res lit history — sharp reflections where the scene
                // is visible, the hybrid cache cone elsewhere.
                reflect_compact_screen: true,
                // HWRT cache sun shadow: TLAS visibility for the relight's direct sun — the GDF
                // march closes the courtyard aperture and shadows the whole sunlit floor in the
                // cache (the mirror's missing sun shaft / shadow-boundary split).
                cache_hwrt_shadow: true,
                // Lit-calibration feedback: per-texel lit/cache ratio EMA (TLAS-validated probes)
                // applied in the reflection sampler — converges the mirror's cache family onto
                // the deferred tone (shadowed reflected floor 76 -> 45 vs deferred 49 /255).
                cache_lit_calib: true,
                // SDF detail-replace: atlas coverage overrides the dense term (the 0.75 m dense
                // voxels read d≈0 through contact gaps and defeat the atlas exactly where the
                // mirror needs it — the ball-bottom band resolves instead of trapping).
                sdf_detail_replace: true,
                // SW compact screen-color-at-hit: the SW mirror march's hit reads the same
                // on-screen lit-history fetch the HWRT hybrid shades from — the contact-gap
                // band gets its grazing-aware witness (chromeball band 96 -> 63 vs hybrid 63,
                // PT 22 /255). Software ReflectMode only (the HWRT fetch has its own gate).
                reflect_hit_fetch: true,
                // F4 importance-sampled final gather (march path, P_GI_VOLUME=0; inert on the
                // default volume-GI path). Measured (chromeball raw GI, frame-pair delta):
                // p99 233 -> 75, >150/255 outliers 1.20% -> 0.92%, per-pixel signal coverage
                // visibly denser; unbiased (converged lit identical, 80.62 lum both); fence
                // A/B 36.30 vs 36.16 ms (free). 0.5 is the sweep knee (0.75 regresses mean).
                gi_importance: 0.5,
            ),
            groups: (
                resolution: 1,
                global_illumination: 0,
                reflection: 1,
                ambient_occlusion: 1,
                shadow: 1,
                surface_cache: 0,
            ),
        ),
    ],
)
